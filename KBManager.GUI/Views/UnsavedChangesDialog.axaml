<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:KBManager.GUI.Views"
        x:Class="KBManager.GUI.Views.UnsavedChangesDialog"
        x:DataType="views:UnsavedChangesDialog"
        Width="480" Height="220"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource BackgroundDefaultColor}"
        Foreground="{DynamicResource TextPrimaryColor}"
        Title="未保存的更改">
    <Grid RowDefinitions="Auto,*,Auto" Margin="24,20">
        <TextBlock Grid.Row="0"
                   Text="有未保存的更改"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryColor}" />

        <TextBlock Grid.Row="1"
                   Text="{Binding Message}"
                   TextWrapping="Wrap"
                   FontSize="13"
                   Margin="0,10,0,0"
                   Foreground="{DynamicResource TextSecondaryColor}" />

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="12"
                    Margin="0,16,0,0">
            <Button Classes="secondary" Content="取消" Width="88" Click="OnCancelClicked" />
            <Button Classes="danger" Content="不保存" Width="88" Click="OnDiscardClicked" />
            <Button Classes="primary" Content="保存" Width="88" Click="OnSaveClicked" />
        </StackPanel>
    </Grid>
</Window>
