<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:KBManager.GUI.ViewModels"
             x:Class="KBManager.GUI.Views.RepoOpsView"
             x:DataType="vm:RepoOpsViewModel"
             x:CompileBindings="False">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24,20">

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <TextBlock Text="📦 Git 操作"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#333" />
            <TextBlock Text="管理 Git 仓库：克隆、暂存、提交、推送"
                       FontSize="13"
                       Foreground="#888" />
        </StackPanel>

        <!-- Action Buttons -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,12">
            <Button Classes="primary" Content="📥 Clone" Command="{Binding CloneRepositoryAsyncCommand}" Margin="0,0,8,8" />
            <Button Classes="primary" Content="📌 Main Add" Command="{Binding MainAddAsyncCommand}" Margin="0,0,8,8" />
            <Button Classes="primary" Content="📌 Sub Add" Command="{Binding SubmoduleAddAsyncCommand}" Margin="0,0,8,8" />
            <Button Classes="secondary" Content="📋 查看配置" Command="{Binding ShowConfigCommand}" Margin="0,0,8,8" />
        </WrapPanel>

        <!-- Commit Section -->
        <Border Grid.Row="2"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="4"
                Padding="16"
                Margin="0,0,0,0">
            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Row="0" Grid.ColumnSpan="3"
                           Text="提交操作"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#333"
                           Margin="0,0,0,8" />

                <TextBox Grid.Row="1" Grid.ColumnSpan="3"
                         Classes="input"
                         Text="{Binding CommitMessage}"
                         Watermark="输入提交信息..."
                         Margin="0,0,0,8" />

                <Button Grid.Row="2" Grid.Column="0"
                        Classes="primary"
                        Content="💾 Main Commit"
                        Command="{Binding MainCommitAsyncCommand}"
                        Margin="0,0,8,8" />
                <Button Grid.Row="2" Grid.Column="1"
                        Classes="secondary"
                        Content="💾 Sub Commit"
                        Command="{Binding SubmoduleCommitAsyncCommand}"
                        Margin="0,0,8,8" />
                <Button Grid.Row="2" Grid.Column="2"
                        Classes="danger"
                        Content="🚀 Push (SSH)"
                        Command="{Binding PushCommand}"
                        Margin="0,0,0,8" />

                <!-- Log Output -->
                <Border Grid.Row="3" Grid.ColumnSpan="3"
                        Background="#1E1E1E"
                        CornerRadius="4"
                        Padding="12"
                        Margin="0,8,0,0">
                    <ScrollViewer>
                        <TextBlock Text="{Binding LogOutput, FallbackValue='操作日志将在此显示...'}"
                                   FontFamily="Cascadia Code, Consolas, monospace"
                                   FontSize="12"
                                   Foreground="#D4D4D4"
                                   TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>

                <TextBlock Grid.Row="4" Grid.ColumnSpan="3"
                           Text="💡 提示: Push 操作使用 SSH 密钥（自动检测 ~/.ssh/id_ed25519 或 id_rsa）"
                           FontSize="11"
                           Foreground="#888"
                           Margin="0,8,0,0" />
            </Grid>
        </Border>

    </Grid>
</UserControl>
