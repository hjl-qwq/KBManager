<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:KBManager.GUI.ViewModels"
             x:Class="KBManager.GUI.Views.ExplorerView"
             x:DataType="vm:ExplorerViewModel">
    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- ═══ Section header, VS Code style: title + compact actions ═══
             固定行高 20px，摘要文字与三个按钮都以这一行的中线对齐（按钮内容也显式居中，
             见 App.axaml 的 Button.icon）。 -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="10,8,6,4" Height="20">
            <TextBlock Grid.Column="0"
                       Text="{Binding FileSummary}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       LetterSpacing="0.4"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource SidebarSectionHeaderColor}" />

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="2"
                        VerticalAlignment="Center">
                <Button Classes="icon" Content="新建"
                        Command="{Binding NewFileCommand}"
                        ToolTip.Tip="新建 Markdown 文件" />
                <Button Classes="icon" Content="同步"
                        Command="{Binding SyncFilesCommand}"
                        ToolTip.Tip="扫描仓库并更新索引" />
                <Button Classes="icon" Content="折叠"
                        Command="{Binding CollapseAllCommand}"
                        ToolTip.Tip="折叠所有目录" />
            </StackPanel>
        </Grid>

        <!-- ═══ Slim filter ═══ -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="10,0,6,5">
            <TextBox Grid.Column="0"
                     Name="FilterBox"
                     Classes="slim"
                     Text="{Binding FilterText}"
                     Watermark="按文件名过滤…" />
            <Button Grid.Column="1"
                    Classes="icon"
                    Content="✕"
                    Margin="2,0,0,0"
                    IsVisible="{Binding HasFilter}"
                    Command="{Binding ClearFilterCommand}"
                    ToolTip.Tip="清除过滤" />
        </Grid>

        <!-- ═══ File tree: compact rows, right-aligned badges, context menu ═══
             Horizontal scrolling is disabled so long names ellipsize instead of
             producing a horizontal scrollbar that overlays the last row. -->
        <TreeView Grid.Row="2"
                  Name="FileTreeView"
                  Padding="0,0,0,4"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  AutoScrollToSelectedItem="True"
                  ItemsSource="{Binding FileTree}"
                  SelectedItem="{Binding SelectedNode, Mode=TwoWay}">
            <TreeView.ItemTemplate>
                <TreeDataTemplate DataType="vm:FileTreeNode" ItemsSource="{Binding Children}">
                    <!--
                        Tag preview. ToolTip.ShowDelay is in milliseconds, so 1000 = the
                        required one-second dwell; Placement=Pointer anchors the popup
                        just below-right of the cursor. The tooltip host is an in-window
                        overlay that inherits this row's DataContext.

                        The badge column is a fixed 28px rather than auto-sized, so the
                        name column is the same width on every row (tagged, untagged and
                        folders alike) and the text is always cut on one straight line.
                        28 = 4px gap + 16px badge + the badge's 8px gap to the row edge.
                    -->
                    <Grid ColumnDefinitions="*,28"
                          Background="Transparent"
                          ToolTip.ShowDelay="1000"
                          ToolTip.Placement="Pointer"
                          ToolTip.HorizontalOffset="14"
                          ToolTip.VerticalOffset="12"
                          ToolTip.BetweenShowDelay="200">
                        <!--
                            Names that do not fit are clipped at the column edge instead of
                            being shortened with an ellipsis: the text runs right up to the
                            edge and disappears "under" it, so dragging the sidebar keeps a
                            continuous edge (an ellipsis re-lays out the run and leaves a
                            ragged gap before the edge). The full name is still in the hover
                            preview above.
                        -->
                        <Border Grid.Column="0" ClipToBounds="True">
                            <TextBlock Text="{Binding Name}"
                                       FontSize="12.5"
                                       VerticalAlignment="Center"
                                       TextWrapping="NoWrap"
                                       TextTrimming="None" />
                        </Border>

                        <!-- The count column: its own faint background plus a hairline on
                             the left, so the badge / file count reads as a separate strip
                             instead of blending into the file name next to it. Both come
                             from the accent hue (not grey) and are semi-transparent, so the
                             row's selection and hover colours still show through and the
                             strip stays in the same colour family as the tag badges.
                             The band only tiles seamlessly because TreeViewItem rows are
                             stretched to their full height, see App.axaml. -->
                        <Border Grid.Column="1"
                                Background="{DynamicResource BackgroundCountColumnColor}"
                                BorderBrush="{DynamicResource BorderCountColumnColor}"
                                BorderThickness="1,0,0,0" />

                        <!-- Tag count badge (files), right-aligned in the count column -->
                        <Border Grid.Column="1"
                                Margin="0,0,8,0"
                                Padding="5,0"
                                CornerRadius="7"
                                MinWidth="16"
                                Height="14"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Background="{DynamicResource BackgroundChipColor}"
                                IsVisible="{Binding HasTags}">
                            <TextBlock Text="{Binding TagCount}"
                                       FontSize="9.5"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextLinkColor}" />
                        </Border>

                        <!-- Child count (directories), right-aligned in the count column -->
                        <TextBlock Grid.Column="1"
                                   Text="{Binding FileCount}"
                                   Margin="0,0,8,0"
                                   FontSize="10"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedColor}"
                                   IsVisible="{Binding ShowFileCountBadge}" />

                        <!-- Row actions: a popup cannot bind back to the explorer, so
                             the commands live on the node itself. -->
                        <Grid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="打开" Command="{Binding ActivateCommand}" />
                                <Separator />
                                <MenuItem Header="用外部程序打开"
                                          Command="{Binding OpenExternallyCommand}"
                                          IsVisible="{Binding IsFile}" />
                                <MenuItem Header="打开所在目录"
                                          Command="{Binding OpenContainingFolderCommand}"
                                          IsVisible="{Binding IsFile}" />
                                <Separator />
                                <MenuItem Header="重命名 / 移动…"
                                          Command="{Binding RenameCommand}"
                                          IsVisible="{Binding IsFile}" />
                                <MenuItem Header="删除…"
                                          Command="{Binding DeleteCommand}"
                                          IsVisible="{Binding IsFile}" />
                            </ContextMenu>
                        </Grid.ContextMenu>

                        <!-- 悬浮预览：只有 ToolTip 这一层外观，内容只有文件名 + 标签 -->
                        <ToolTip.Tip>
                            <StackPanel Spacing="5" MinWidth="110" MaxWidth="260">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />

                                <!-- Tags of the hovered file -->
                                <ItemsControl ItemsSource="{Binding Tags}"
                                              IsVisible="{Binding HasTags}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Border Classes="chip" Margin="0,0,4,3">
                                                <TextBlock Text="{Binding}"
                                                           FontSize="10.5"
                                                           Foreground="{DynamicResource TextLinkColor}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="暂无标签"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource TextMutedColor}"
                                           IsVisible="{Binding ShowEmptyTagHint}" />
                            </StackPanel>
                        </ToolTip.Tip>
                    </Grid>
                </TreeDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <!-- ═══ Hint / status ═══ -->
        <TextBlock Grid.Row="3"
                   Margin="10,6,10,8"
                   FontSize="10.5"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextMutedColor}"
                   IsVisible="{Binding !IsRepositoryConfigured}"
                   Text="尚未配置仓库目录。请在左下角「设置」中填写本地知识库路径。" />

        <StackPanel Grid.Row="3" Margin="10,6,10,8" Spacing="4"
                    IsVisible="{Binding IsRepositoryConfigured}">
            <!-- 索引与实际目录不一致时的入口。
                 这里只放一行计数 + 一个按钮：失效记录可能很多，把它们铺在侧边栏里会挤掉文件树，
                 所以完整列表放在编辑区的一个标签页里（点按钮打开）。 -->
            <Border IsVisible="{Binding HasStaleIndexRecords}"
                    Background="{DynamicResource BackgroundSectionColor}"
                    BorderBrush="{DynamicResource BorderDefaultColor}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="8,6"
                    ToolTip.Placement="Top"
                    ToolTip.HorizontalOffset="0"
                    ToolTip.VerticalOffset="-8">
                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding StaleSummary}"
                               FontSize="10.5"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextDangerColor}" />

                    <Button Classes="toolbar"
                            Content="查看并清理…"
                            HorizontalAlignment="Left"
                            Command="{Binding OpenStaleRecordsCommand}" />
                </StackPanel>

                <!-- 浮层说明：向上弹出（这块面板贴着窗口底部，向下弹会被下沿挤压）；
                     内容保持简短并固定宽度，避免因空间不足被裁成空框。 -->
                <ToolTip.Tip>
                    <StackPanel Width="270" Spacing="5">
                        <TextBlock Text="失效记录是什么？"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryColor}" />
                        <TextBlock FontSize="10.5"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryColor}"
                                   Text="索引（数据库）里还留着、但磁盘上文件已经不存在的记录。" />
                        <TextBlock Text="点按钮会做什么？"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryColor}" />
                        <TextBlock FontSize="10.5"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryColor}"
                                   Text="在右侧编辑区打开一页，列出全部失效记录，由你在那里决定是否清理。清理只删索引记录与标签，不动磁盘文件。" />
                    </StackPanel>
                </ToolTip.Tip>
            </Border>

            <!-- 底部状态行：只在有实际反馈（同步结果、出错信息）时出现。
                 文件数量已经在顶部的摘要里显示，这里不再重复，也不占着一行空白。 -->
            <TextBlock FontSize="10.5"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMutedColor}"
                       IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Text="{Binding StatusMessage}" />
        </StackPanel>
    </Grid>
</UserControl>
