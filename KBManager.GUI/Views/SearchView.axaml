<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:KBManager.GUI.ViewModels"
             x:Class="KBManager.GUI.Views.SearchView"
             x:DataType="vm:SearchViewModel">
    <Grid RowDefinitions="Auto,Auto,*" Margin="24,20">

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <TextBlock Text="🔍 搜索文件"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#333" />
            <TextBlock Text="输入标签名称，查找带有该标签的所有文件"
                       FontSize="13"
                       Foreground="#888" />
        </StackPanel>

        <!-- Search Bar -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <TextBox Grid.Column="0"
                     Classes="input"
                     Text="{Binding SearchTag}"
                     Watermark="输入标签名称..."
                     Margin="0,0,12,0" />
            <Button Grid.Column="1"
                    Classes="primary"
                    Content="🔍 搜索"
                    Command="{Binding SearchCommand}"
                    Width="100" />
        </Grid>

        <!-- Results Table -->
        <Border Grid.Row="2"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="4">
            <Grid RowDefinitions="Auto,*,Auto">
                <!-- Table Header -->
                <Grid Grid.Row="0"
                      ColumnDefinitions="*,120"
                      Background="#F5F5F5"
                      Height="36">
                    <TextBlock Grid.Column="0"
                               Text="  文件名"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Foreground="#666"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="标签"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Foreground="#666"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- Results List -->
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Results}"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,120"
                                  Margin="0,2"
                                  Height="32">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding FileName}"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           Margin="8,0" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding TagsDisplay}"
                                           FontSize="12"
                                           Foreground="#0078D4"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Summary -->
                <Border Grid.Row="2"
                        Background="#FAFAFA"
                        BorderBrush="#E0E0E0"
                        BorderThickness="0,1,0,0"
                        Padding="12,6">
                    <TextBlock Text="{Binding ResultSummary}"
                               FontSize="12"
                               Foreground="#888" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
