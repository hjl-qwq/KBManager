<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:KBManager.GUI.ViewModels"
             x:Class="KBManager.GUI.Views.SearchView"
             x:DataType="vm:SearchViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="24,20">

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <TextBlock Text="🔍 搜索文件"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryColor}" />
            <TextBlock Text="输入标签名称，查找带有该标签的所有文件"
                       FontSize="13"
                       Foreground="{DynamicResource TextMutedColor}" />
        </StackPanel>

        <!-- Search Bar -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
            <TextBox Grid.Column="0"
                     x:Name="TagTextBox"
                     Classes="input"
                     Text="{Binding SearchTag}"
                     Watermark="输入标签名称..."
                     Margin="0,0,12,0" />
            <Button Grid.Column="1"
                    Classes="primary"
                    Content="🔍 搜索"
                    Command="{Binding SearchCommand}"
                    Width="100" />
        </Grid>

        <!-- Tag Suggestion Dropdown -->
        <Border Grid.Row="2"
                IsVisible="{Binding IsSuggestionOpen}"
                BorderBrush="{DynamicResource BorderDefaultColor}"
                BorderThickness="1"
                CornerRadius="0,0,4,4"
                Background="{DynamicResource BackgroundDefaultColor}"
                Margin="0,0,0,8"
                MaxHeight="220">
            <ListBox x:Name="SuggestionListBox"
                     ItemsSource="{Binding TagSuggestions}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0,4">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:TagSuggestion">
                        <Grid ColumnDefinitions="*,Auto"
                              Margin="0,1"
                              Height="32"
                              Background="Transparent">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding TagName}"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextPrimaryColor}"
                                       VerticalAlignment="Center"
                                       Margin="12,0,8,0" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding FileCount, StringFormat='{}{0} 个文件'}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextMutedColor}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Padding" Value="0" />
                    </Style>
                    <Style Selector="ListBoxItem:pointerover">
                        <Setter Property="Background" Value="{DynamicResource BackgroundHoverColor}" />
                    </Style>
                    <Style Selector="ListBoxItem:selected">
                        <Setter Property="Background" Value="{DynamicResource BackgroundSelectedColor}" />
                    </Style>
                </ListBox.Styles>
            </ListBox>
        </Border>

        <!-- Results Table -->
        <Border Grid.Row="3"
                BorderBrush="{DynamicResource BorderDefaultColor}"
                BorderThickness="1"
                CornerRadius="4">
            <Grid RowDefinitions="Auto,*,Auto">
                <!-- Table Header -->
                <Grid Grid.Row="0"
                      ColumnDefinitions="*,120"
                      Background="{DynamicResource BackgroundHeaderRowColor}"
                      Height="36">
                    <TextBlock Grid.Column="0"
                               Text="  文件名"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Foreground="{DynamicResource TextStatusColor}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="标签"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Foreground="{DynamicResource TextStatusColor}"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- Results List -->
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Results}"
                         Background="{DynamicResource BackgroundDefaultColor}"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,120"
                                  Margin="0,2"
                                  Height="32">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding FileName}"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextPrimaryColor}"
                                           VerticalAlignment="Center"
                                           Margin="8,0" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding TagsDisplay}"
                                           FontSize="12"
                                           Foreground="{DynamicResource PrimaryColor}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Summary -->
                <Border Grid.Row="2"
                        Background="{DynamicResource BackgroundFooterColor}"
                        BorderBrush="{DynamicResource BorderDefaultColor}"
                        BorderThickness="0,1,0,0"
                        Padding="12,6">
                    <TextBlock Text="{Binding ResultSummary}"
                               FontSize="12"
                               Foreground="{DynamicResource TextMutedColor}" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
