<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:KBManager.GUI.ViewModels"
             x:Class="KBManager.GUI.Views.SearchView"
             x:DataType="vm:SearchViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- ═══ Header ═══ -->
        <StackPanel Grid.Row="0" Margin="12,10,12,8" Spacing="8">
            <TextBlock Text="按标签检索"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource SidebarSectionHeaderColor}" />
            <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0"
                         Name="TagTextBox"
                         Classes="input"
                         Text="{Binding SearchTag}"
                         Watermark="标签名称…"
                         FontSize="12"
                         Padding="8,5" />
                <Button Grid.Column="1"
                        Classes="toolbar"
                        Content="检索"
                        Margin="4,0,0,0"
                        Command="{Binding SearchCommand}" />
            </Grid>
            <Button Classes="toolbar"
                    Content="清空"
                    HorizontalAlignment="Left"
                    Command="{Binding ClearSearchCommand}"
                    IsVisible="{Binding HasSearched}" />
        </StackPanel>

        <!-- ═══ Tag browser / suggestions ═══ -->
        <Border Grid.Row="1"
                Margin="8,0,8,8"
                MaxHeight="260"
                BorderBrush="{DynamicResource BorderDefaultColor}"
                BorderThickness="1"
                CornerRadius="4"
                IsVisible="{Binding IsSuggestionOpen}">
            <Grid RowDefinitions="Auto,*">
                <TextBlock Grid.Row="0"
                           Text="{Binding SuggestionHeader}"
                           FontSize="10"
                           Margin="8,6,8,2"
                           Foreground="{DynamicResource TextMutedColor}" />
                <ScrollViewer Grid.Row="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox Name="SuggestionListBox"
                             ItemsSource="{Binding TagSuggestions}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0,0,0,4">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="8,4" />
                                <Setter Property="Cursor" Value="Hand" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:TagSuggestionItem">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding TagName}"
                                               FontSize="12"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding FileCount, StringFormat='{}{0} 个文件'}"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource TextMutedColor}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ═══ Results header ═══ -->
        <TextBlock Grid.Row="2"
                   Text="{Binding ResultSummary}"
                   FontSize="11"
                   Margin="12,0,12,6"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextMutedColor}" />

        <!-- ═══ Results: click a row to open it in the editor ═══
             横向滚动禁用：结果行的名字用省略号截断，避免底部出现一条横向滚动条。 -->
        <ScrollViewer Grid.Row="3" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Results}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FileSearchResultItem">
                        <!-- 行本身是按钮，所以"移除记录"放在同一行的另一列，
                             避免按钮嵌套。磁盘上已不存在的行不可点击打开。 -->
                        <Grid ColumnDefinitions="*,Auto">
                            <Button Grid.Column="0"
                                    Classes="result"
                                    Command="{Binding $parent[ItemsControl].((vm:SearchViewModel)DataContext).OpenResultCommand}"
                                    CommandParameter="{Binding}"
                                    IsEnabled="{Binding ExistsOnDisk}"
                                    ToolTip.Tip="{Binding RelativePath}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontSize="12.5"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding DirectoryLabel}"
                                               FontSize="10"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextMutedColor}"
                                               IsVisible="{Binding HasDirectoryLabel}" />
                                    <TextBlock Text="{Binding TagsDisplay}"
                                               FontSize="10.5"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextLinkColor}" />
                                    <!-- 索引记录存在、但磁盘上文件已不在 -->
                                    <TextBlock Text="{Binding MissingHint}"
                                               FontSize="10"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextDangerColor}"
                                               IsVisible="{Binding IsMissing}" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="1"
                                    Classes="icon"
                                    Content="移除记录"
                                    Margin="4,0,8,0"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding IsMissing}"
                                    Command="{Binding $parent[ItemsControl].((vm:SearchViewModel)DataContext).RemoveStaleRecordCommand}"
                                    CommandParameter="{Binding}"
                                    ToolTip.Tip="从索引中移除这条失效记录（磁盘文件不受影响）" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
