<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:KBManager.GUI.ViewModels"
             xmlns:conv="clr-namespace:KBManager.GUI.Converters"
             x:Class="KBManager.GUI.Views.FileListView"
             x:DataType="vm:FileListViewModel">
    <UserControl.Resources>
        <conv:DirectoryIconConverter x:Key="DirIcon" />
        <conv:BoolInvertConverter x:Key="BoolInv" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,Auto,*" Margin="24,20">

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="📁 文件管理"
                           FontSize="20" FontWeight="SemiBold" Foreground="#333"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding FileSummary}"
                           FontSize="13" Foreground="#888"
                           VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="树形浏览知识库文件，管理标签"
                       FontSize="13" Foreground="#888" />
        </StackPanel>

        <!-- Toolbar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <Button Classes="primary" Content="🔄 同步文件" Command="{Binding SyncFilesCommand}" />
            <Button Classes="secondary" Content="📝 打开编辑"
                    Command="{Binding OpenFileCommand}"
                    IsEnabled="{Binding HasSelection}" />
            <Button Classes="danger" Content="🗑 移除记录"
                    Command="{Binding RemoveFileCommand}"
                    IsEnabled="{Binding HasSelection}" />
        </StackPanel>

        <!-- Main Content -->
        <Grid Grid.Row="2" ColumnDefinitions="*,320">
            <!-- File Tree -->
            <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="1"
                    CornerRadius="4" Margin="0,0,12,0" Padding="4">
                <ScrollViewer>
                    <TreeView Name="FileTreeView"
                              ItemsSource="{Binding FileTree}"
                              SelectedItem="{Binding SelectedNode, Mode=TwoWay}">
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate DataType="vm:FileTreeNode"
                                              ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="2,3">
                                    <TextBlock Text="{Binding IsDirectory, Converter={StaticResource DirIcon}}"
                                               FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="13" Foreground="#333"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding TagCount, StringFormat='({0})'}"
                                               FontSize="11" Foreground="#0078D4"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding IsDirectory, Converter={StaticResource BoolInv}}" />
                                </StackPanel>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </ScrollViewer>
            </Border>

            <!-- Tag Editor Panel -->
            <Border Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="1"
                    CornerRadius="4" Padding="16">
                <ScrollViewer>
                    <StackPanel Spacing="12">
                        <TextBlock Text="标签编辑" FontSize="16"
                                   FontWeight="SemiBold" Foreground="#333" />

                        <!-- Selected File -->
                        <Border Background="#F5F5F5" CornerRadius="4" Padding="10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="当前文件" FontSize="11" Foreground="#888" />
                                <TextBlock Text="{Binding SelectedNode.Name, FallbackValue='(未选择)'}"
                                           FontSize="13" Foreground="#333" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Tag Chips -->
                        <Border Background="#F5F5F5" CornerRadius="4" Padding="10"
                                IsVisible="{Binding HasSelection}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="现有标签（点击 ✕ 移除）" FontSize="11" Foreground="#888" />
                                <ItemsControl ItemsSource="{Binding CurrentTags}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:FileTagItem">
                                            <Border Background="#E3F2FD" CornerRadius="10"
                                                    Padding="8,4" Margin="0,0,4,4">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="{Binding TagName}" FontSize="12"
                                                               Foreground="#1565C0" VerticalAlignment="Center" />
                                                    <Button Content="✕" Background="Transparent"
                                                            Foreground="#C62828" FontSize="11"
                                                            Padding="2,0" BorderThickness="0" Cursor="Hand"
                                                            VerticalAlignment="Center"
                                                            Tag="{Binding .}"
                                                            Click="OnRemoveTagClicked" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Add Tag -->
                        <Separator Background="#E0E0E0" />
                        <TextBlock Text="添加新标签" FontSize="12" FontWeight="SemiBold" Foreground="#555" />
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <TextBox Grid.Row="0" Grid.Column="0"
                                     Classes="input"
                                     Text="{Binding NewTagName}"
                                     Watermark="输入标签名..."
                                     IsEnabled="{Binding HasSelection}"
                                     Margin="0,0,8,0" />
                            <Button Grid.Row="0" Grid.Column="1"
                                    Classes="primary" Content="➕"
                                    Command="{Binding AddTagCommand}"
                                    IsEnabled="{Binding HasSelection}" Width="44" />

                            <!-- Suggestions dropdown -->
                            <ListBox Grid.Row="1" Grid.Column="0"
                                     ItemsSource="{Binding TagSuggestions}"
                                     Margin="0,2,8,0" MaxHeight="160"
                                     BorderBrush="#E0E0E0" BorderThickness="1" Background="White">
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Padding" Value="8,4" />
                                        <Setter Property="FontSize" Value="12" />
                                        <Setter Property="Cursor" Value="Hand" />
                                    </Style>
                                    <Style Selector="ListBoxItem:pointerover">
                                        <Setter Property="Background" Value="#E3F2FD" />
                                    </Style>
                                </ListBox.Styles>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="x:String">
                                        <TextBlock Text="{Binding .}" Foreground="#333" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="11" Foreground="#888" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
