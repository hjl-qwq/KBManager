<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:KBManager.GUI.Views"
        x:Class="KBManager.GUI.Views.TextInputDialog"
        x:DataType="views:TextInputDialog"
        Width="520" Height="240"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource BackgroundDefaultColor}"
        Foreground="{DynamicResource TextPrimaryColor}"
        Title="输入">
    <Grid RowDefinitions="Auto,Auto,*" Margin="24,20">
        <TextBlock Grid.Row="0"
                   Text="{Binding Prompt}"
                   TextWrapping="Wrap"
                   FontSize="13"
                   Foreground="{DynamicResource TextSecondaryColor}" />

        <TextBox Grid.Row="1"
                 Name="InputBox"
                 Classes="input"
                 Margin="0,12,0,0"
                 FontFamily="Cascadia Code, Consolas, DejaVu Sans Mono, monospace"
                 FontSize="13"
                 KeyDown="OnInputKeyDown" />

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Spacing="12"
                    Margin="0,16,0,0">
            <Button Classes="secondary" Content="取消" Width="80" Click="OnCancelClicked" />
            <Button Classes="primary" Content="确定" Width="80" Click="OnOkClicked" />
        </StackPanel>
    </Grid>
</Window>
