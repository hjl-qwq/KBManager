<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:KBManager.GUI.ViewModels"
             x:Class="KBManager.GUI.Views.FileEditorView"
             x:DataType="vm:FileDocumentViewModel">
    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ═══ Document strip: exactly one row, tags on the left, add-tag on the right ═══
             The chip list scrolls sideways rather than wrapping, so adding tags can
             never push the text surface down. Trimmed to the same height as the tab
             strip above, so the editor's three chrome rows read as one grid. -->
        <Border Grid.Row="0" Classes="toolbar" Padding="10,1">
            <Grid ColumnDefinitions="*,Auto">

                <ScrollViewer Grid.Column="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              Margin="0,0,10,0">
                    <ItemsControl ItemsSource="{Binding Tags}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:FileTagItem">
                                <Border Classes="chip" Margin="0,0,5,0">
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <TextBlock Text="{Binding TagName}"
                                                   FontSize="10.5"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextLinkColor}" />
                                        <Button Classes="tabclose"
                                                Content="✕"
                                                Width="12"
                                                Height="12"
                                                FontSize="9"
                                                Tag="{Binding}"
                                                Click="OnRemoveTagClicked"
                                                ToolTip.Tip="移除此标签" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Empty hint shares the chip cell, so it cannot add a row either -->
                <TextBlock Grid.Column="0"
                           Text="暂无标签"
                           FontSize="11"
                           Margin="2,0,0,0"
                           VerticalAlignment="Center"
                           IsVisible="{Binding !HasTags}"
                           Foreground="{DynamicResource TextMutedColor}" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="6"
                            VerticalAlignment="Center">
                    <TextBox Name="NewTagTextBox"
                             Classes="slim"
                             Width="170"
                             Height="24"
                             Text="{Binding NewTagName}"
                             Watermark="添加标签…"
                             ToolTip.Tip="输入标签名后回车添加；输入时会列出已有标签" />
                    <Button Classes="toolbar"
                            Content="添加"
                            Height="24"
                            Command="{Binding AddTagCommand}"
                            ToolTip.Tip="为这篇笔记添加标签" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Text surface: a fixed gutter plus soft-wrapped text ═══
             Horizontal scrolling is disabled on this scroller, so the content is
             measured at the viewport width: the text wraps instead of running off to
             the right, and the line-number gutter can never be scrolled out of view.
             Soft wrapping is display only — the buffer keeps one logical line per
             newline, so nothing is written back to disk with hard breaks. -->
        <ScrollViewer Grid.Row="1"
                      Name="EditorScroll"
                      Background="{DynamicResource EditorBackgroundColor}"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <Grid ColumnDefinitions="Auto,*">
                <Border Grid.Column="0" Classes="gutter" MinWidth="52">
                    <!-- Filled by the view from the editor's own text layout, one
                         number per logical line, blank rows for wrapped continuations. -->
                    <TextBlock Name="GutterLines"
                               FontFamily="Cascadia Code, Consolas, DejaVu Sans Mono, monospace"
                               FontSize="13"
                               LineHeight="20"
                               Padding="4,8,10,8"
                               TextAlignment="Right"
                               Foreground="{DynamicResource EditorLineNumberColor}" />
                </Border>

                <TextBox Grid.Column="1"
                         Name="EditorBox"
                         Classes="editor"
                         Text="{Binding Content, Mode=TwoWay}"
                         CaretIndex="{Binding CaretIndex, Mode=TwoWay}" />
            </Grid>
        </ScrollViewer>

        <!-- ═══ Tag autocomplete: an overlay, so it never pushes the editor down ═══ -->
        <ListBox Grid.Row="1"
                 Name="TagSuggestionListBox"
                 ItemsSource="{Binding TagSuggestions}"
                 IsVisible="{Binding HasTagSuggestions}"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Top"
                 Width="190"
                 MaxHeight="150"
                 Margin="0,4,56,0"
                 BorderBrush="{DynamicResource BorderDefaultColor}"
                 BorderThickness="1"
                 Background="{DynamicResource BackgroundDefaultColor}">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="8,3" />
                    <Setter Property="Cursor" Value="Hand" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:TagSuggestionItem">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding TagName}"
                                   FontSize="11.5"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding FileCount, StringFormat='{}{0} 个文件'}"
                                   FontSize="10"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedColor}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- ═══ Status strip: document metrics and feedback, one short line ═══
             No save / reload buttons here: Ctrl+S and Ctrl+R (and the window's
             key bindings) are the save path, and the strip stays the same height as
             the window status bar instead of being sized by a button. -->
        <Border Grid.Row="2"
                Background="{DynamicResource BackgroundFooterColor}"
                BorderBrush="{DynamicResource BorderDefaultColor}"
                BorderThickness="0,1,0,0"
                Height="26"
                Padding="12,0">
            <StackPanel Orientation="Horizontal"
                        Spacing="14"
                        VerticalAlignment="Center"
                        ClipToBounds="True">
                <TextBlock FontSize="11"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedColor}"
                           Text="{Binding CaretLine, StringFormat='行 {0}'}" />
                <TextBlock FontSize="11"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedColor}"
                           Text="{Binding CaretColumn, StringFormat='列 {0}'}" />
                <TextBlock FontSize="11"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedColor}"
                           Text="{Binding LineCount, StringFormat='共 {0} 行'}" />
                <TextBlock FontSize="11"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedColor}"
                           Text="{Binding CharacterCount, StringFormat='{}{0} 字符'}" />
                <TextBlock FontSize="11"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedColor}"
                           Text="{Binding EncodingLabel}" />
                <TextBlock FontSize="11"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedColor}"
                           Text="{Binding LineEndingLabel}" />
                <!-- The save affordance now that the button is gone -->
                <TextBlock FontSize="11"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TabDirtyIndicatorColor}"
                           IsVisible="{Binding IsDirty}"
                           Text="未保存 · Ctrl+S 保存" />
                <TextBlock FontSize="11"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextDangerColor}"
                           IsVisible="{Binding HasDecodingWarning}"
                           Text="编码警告：该文件不是有效的 UTF-8" />
                <!-- Per-document feedback (save result, tag result, load warning) -->
                <TextBlock FontSize="11"
                           MaxWidth="420"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextLinkColor}"
                           Text="{Binding InfoMessage}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
