<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:KBManager.GUI.ViewModels"
             x:Class="KBManager.GUI.Views.FileEditorView"
             x:DataType="vm:FileDocumentViewModel">
    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- ═══ Document toolbar: path, dirty state, actions ═══ -->
        <Border Grid.Row="0" Classes="toolbar" Padding="12,7">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding RelativePath}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <Border Background="{DynamicResource TabDirtyIndicatorColor}"
                            CornerRadius="3"
                            Padding="6,1"
                            VerticalAlignment="Center"
                            IsVisible="{Binding IsDirty}">
                        <TextBlock Text="未保存"
                                   FontSize="10"
                                   Foreground="{DynamicResource PrimaryForegroundColor}" />
                    </Border>
                    <Border Background="{DynamicResource BackgroundChipColor}"
                            CornerRadius="3"
                            Padding="6,1"
                            VerticalAlignment="Center"
                            IsVisible="{Binding HasDecodingWarning}">
                        <TextBlock Text="编码警告"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextDangerColor}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <Button Classes="primary"
                            Content="保存"
                            Padding="14,5"
                            Command="{Binding SaveCommand}"
                            IsEnabled="{Binding CanSave}"
                            ToolTip.Tip="保存到磁盘 (Ctrl+S)" />
                    <Button Classes="toolbar"
                            Content="重新加载"
                            Command="{Binding ReloadCommand}"
                            ToolTip.Tip="丢弃缓冲区修改并从磁盘重新读取 (Ctrl+R)" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Tag strip: the "Manager" half of the workspace ═══ -->
        <Border Grid.Row="1" Classes="toolbar" Padding="12,8">
            <StackPanel Spacing="6">
                <!-- Bounded width for the chip column so the WrapPanel can wrap -->
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Grid.Column="0"
                               Text="标签"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SidebarSectionHeaderColor}" />

                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Tags}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:FileTagItem">
                                <Border Classes="chip" Margin="0,0,4,2">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{Binding TagName}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextLinkColor}" />
                                        <Button Classes="tabclose"
                                                Content="✕"
                                                Width="14"
                                                Height="14"
                                                Tag="{Binding}"
                                                Click="OnRemoveTagClicked"
                                                ToolTip.Tip="移除此标签" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Grid.Column="1"
                               Text="暂无标签，可在下方添加"
                               FontSize="11"
                               Margin="2,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedColor}"
                               IsVisible="{Binding !HasTags}" />
                </Grid>

                <!-- Add tag + autocomplete -->
                <Grid ColumnDefinitions="240,Auto,*">
                    <TextBox Grid.Column="0"
                             Name="NewTagTextBox"
                             Classes="input"
                             Text="{Binding NewTagName}"
                             Watermark="输入标签名后回车"
                             FontSize="12"
                             Padding="8,5" />
                    <Button Grid.Column="1"
                            Classes="toolbar"
                            Content="添加"
                            Margin="6,0,0,0"
                            Command="{Binding AddTagCommand}" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding InfoMessage}"
                               FontSize="11"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextMutedColor}" />
                </Grid>

                <ListBox Name="TagSuggestionListBox"
                         ItemsSource="{Binding TagSuggestions}"
                         IsVisible="{Binding HasTagSuggestions}"
                         MaxHeight="120"
                         BorderBrush="{DynamicResource BorderDefaultColor}"
                         BorderThickness="1"
                         Background="{DynamicResource BackgroundDefaultColor}">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="8,4" />
                            <Setter Property="Cursor" Value="Hand" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:TagSuggestionItem">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding TagName}"
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding FileCount, StringFormat='{}{0} 个文件'}"
                                           FontSize="10.5"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedColor}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <!-- ═══ Text surface: gutter + editor inside one scroller ═══
             The TextBox's own scrolling is disabled (see TextBox.editor), so it
             grows to its content and this ScrollViewer scrolls the gutter and the
             text together, keeping line numbers aligned. -->
        <ScrollViewer Grid.Row="2"
                      Name="EditorScroll"
                      Background="{DynamicResource EditorBackgroundColor}"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <Grid ColumnDefinitions="Auto,*"
                  MinWidth="{Binding #EditorScroll.Viewport.Width}"
                  MinHeight="240">
                <Border Grid.Column="0" Classes="gutter" MinWidth="52">
                    <TextBlock Text="{Binding GutterText}"
                               FontFamily="Cascadia Code, Consolas, DejaVu Sans Mono, monospace"
                               FontSize="13"
                               LineHeight="20"
                               Padding="4,8,10,8"
                               TextAlignment="Right"
                               Foreground="{DynamicResource EditorLineNumberColor}" />
                </Border>

                <TextBox Grid.Column="1"
                         Classes="editor"
                         Text="{Binding Content, Mode=TwoWay}"
                         CaretIndex="{Binding CaretIndex, Mode=TwoWay}"
                         MinWidth="400" />
            </Grid>
        </ScrollViewer>

        <!-- ═══ Per-document status strip ═══ -->
        <Border Grid.Row="3"
                Background="{DynamicResource BackgroundFooterColor}"
                BorderBrush="{DynamicResource BorderDefaultColor}"
                BorderThickness="0,1,0,0"
                Padding="12,4">
            <StackPanel Orientation="Horizontal" Spacing="14">
                <TextBlock FontSize="11"
                           Foreground="{DynamicResource TextMutedColor}"
                           Text="{Binding CaretLine, StringFormat='行 {0}'}" />
                <TextBlock FontSize="11"
                           Foreground="{DynamicResource TextMutedColor}"
                           Text="{Binding CaretColumn, StringFormat='列 {0}'}" />
                <TextBlock FontSize="11"
                           Foreground="{DynamicResource TextMutedColor}"
                           Text="{Binding LineCount, StringFormat='共 {0} 行'}" />
                <TextBlock FontSize="11"
                           Foreground="{DynamicResource TextMutedColor}"
                           Text="{Binding CharacterCount, StringFormat='{}{0} 字符'}" />
                <TextBlock FontSize="11"
                           Foreground="{DynamicResource TextMutedColor}"
                           Text="{Binding EncodingLabel}" />
                <TextBlock FontSize="11"
                           Foreground="{DynamicResource TextMutedColor}"
                           Text="{Binding LineEndingLabel}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
