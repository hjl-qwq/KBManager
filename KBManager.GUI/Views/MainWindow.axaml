<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:KBManager.GUI.ViewModels"
        xmlns:views="clr-namespace:KBManager.GUI.Views"
        xmlns:conv="clr-namespace:KBManager.GUI.Converters"
        x:Class="KBManager.GUI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="KBManager — Knowledge Base Manager"
        Width="1100" Height="700"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:CollectionCountConverter x:Key="CountConverter" />
        <conv:StringListJoinConverter x:Key="TagJoinConverter" />
    </Window.Resources>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Title Bar -->
        <Border Grid.Row="0"
                Background="{DynamicResource TitleBarBackgroundColor}"
                Padding="16,10"
                CornerRadius="0">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <TextBlock Text="📚 KBManager"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextOnPrimaryColor}"
                           VerticalAlignment="Center" />
                <TextBlock Text="Knowledge Base Manager"
                           FontSize="13"
                           Foreground="{DynamicResource TextOnPrimaryLightColor}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1" ColumnDefinitions="220,*">
            <!-- Left Navigation -->
            <Border Grid.Column="0"
                    Background="{DynamicResource BackgroundSidebarColor}"
                    BorderBrush="{DynamicResource BorderDefaultColor}"
                    BorderThickness="0,0,1,0">
                <StackPanel Margin="0,12,0,0" Spacing="2">
                    <!-- Navigation Header -->
                    <TextBlock Text="导航"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedColor}"
                               Margin="16,0,0,8" />

                    <!-- Nav Buttons -->
                    <Button Content="🔍  搜索文件"
                            Classes="nav"
                            Command="{Binding NavigateToSearchCommand}" />
                    <Button Content="📁  文件管理"
                            Classes="nav"
                            Command="{Binding NavigateToFileListCommand}" />
                    <Button Content="⚙  设置"
                            Classes="nav"
                            Command="{Binding NavigateToSettingsCommand}" />
                    <Button Content="📦  Git 操作"
                            Classes="nav"
                            Command="{Binding NavigateToRepoOpsCommand}" />

                    <!-- Spacer -->
                    <Separator Margin="8,16,8,8" Background="{DynamicResource BorderDefaultColor}" />

                    <!-- Repository Info -->
                    <StackPanel Margin="12,4">
                        <TextBlock Text="仓库信息"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedColor}"
                                   Margin="4,0,0,4" />
                        <TextBlock Text="{Binding RepositoryPath}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryColor}"
                                   TextWrapping="Wrap"
                                   Margin="4,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Right Content Area -->
            <Border Grid.Column="1" Background="{DynamicResource BackgroundDefaultColor}">
                <ContentControl Content="{Binding CurrentPageViewModel}">
                    <ContentControl.DataTemplates>
                        <!-- Page Template Selector -->
                        <DataTemplate DataType="vm:SearchViewModel">
                            <views:SearchView />
                        </DataTemplate>
                        <DataTemplate DataType="vm:FileListViewModel">
                            <views:FileListView />
                        </DataTemplate>
                        <DataTemplate DataType="vm:SettingsViewModel">
                            <views:SettingsView />
                        </DataTemplate>
                        <DataTemplate DataType="vm:RepoOpsViewModel">
                            <views:RepoOpsView />
                        </DataTemplate>
                    </ContentControl.DataTemplates>
                </ContentControl>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2"
                Background="{DynamicResource BackgroundStatusBarColor}"
                BorderBrush="{DynamicResource BorderDefaultColor}"
                BorderThickness="0,1,0,0"
                Padding="16,6">
            <StackPanel Orientation="Horizontal" Spacing="24">
                <TextBlock FontSize="11"
                           Foreground="{DynamicResource TextStatusColor}"
                           Text="{Binding StatusMessage}" />
                <TextBlock FontSize="11"
                           Foreground="{DynamicResource TextMutedColor}"
                           Text="|" />
                <TextBlock FontSize="11"
                           Foreground="{DynamicResource TextMutedColor}"
                           Text="{Binding RepositoryPath, StringFormat='仓库: {0}'}" />
            </StackPanel>
        </Border>
    </Grid>

    <!-- Styles now in App.axaml (application-level) -->
    <Window.Styles />
</Window>
