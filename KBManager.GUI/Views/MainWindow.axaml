<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:KBManager.GUI.ViewModels"
        xmlns:views="clr-namespace:KBManager.GUI.Views"
        xmlns:conv="clr-namespace:KBManager.GUI.Converters"
        x:Class="KBManager.GUI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="KBManager — Knowledge Base Manager"
        Width="1100" Height="700"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:CollectionCountConverter x:Key="CountConverter" />
        <conv:StringListJoinConverter x:Key="TagJoinConverter" />
    </Window.Resources>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Title Bar -->
        <Border Grid.Row="0"
                Background="#0078D4"
                Padding="16,10"
                CornerRadius="0">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <TextBlock Text="📚 KBManager"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center" />
                <TextBlock Text="Knowledge Base Manager"
                           FontSize="13"
                           Foreground="#B3D9FF"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1" ColumnDefinitions="220,*">
            <!-- Left Navigation -->
            <Border Grid.Column="0"
                    Background="#F5F5F5"
                    BorderBrush="#E0E0E0"
                    BorderThickness="0,0,1,0">
                <StackPanel Margin="0,12,0,0" Spacing="2">
                    <!-- Navigation Header -->
                    <TextBlock Text="导航"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#888"
                               Margin="16,0,0,8" />

                    <!-- Nav Buttons -->
                    <Button Content="🔍  搜索文件"
                            Classes="nav"
                            Command="{Binding NavigateToSearchCommand}" />
                    <Button Content="📁  文件管理"
                            Classes="nav"
                            Command="{Binding NavigateToFileListCommand}" />
                    <Button Content="⚙  设置"
                            Classes="nav"
                            Command="{Binding NavigateToSettingsCommand}" />
                    <Button Content="📦  Git 操作"
                            Classes="nav"
                            Command="{Binding NavigateToRepoOpsCommand}" />

                    <!-- Spacer -->
                    <Separator Margin="8,16,8,8" Background="#E0E0E0" />

                    <!-- Repository Info -->
                    <StackPanel Margin="12,4">
                        <TextBlock Text="仓库信息"
                                   FontSize="11"
                                   Foreground="#888"
                                   Margin="4,0,0,4" />
                        <TextBlock Text="{Binding RepositoryPath}"
                                   FontSize="11"
                                   Foreground="#555"
                                   TextWrapping="Wrap"
                                   Margin="4,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Right Content Area -->
            <Border Grid.Column="1" Background="White">
                <ContentControl Content="{Binding CurrentPageViewModel}">
                    <ContentControl.DataTemplates>
                        <!-- Page Template Selector -->
                        <DataTemplate DataType="vm:SearchViewModel">
                            <views:SearchView />
                        </DataTemplate>
                        <DataTemplate DataType="vm:FileListViewModel">
                            <views:FileListView />
                        </DataTemplate>
                        <DataTemplate DataType="vm:SettingsViewModel">
                            <views:SettingsView />
                        </DataTemplate>
                        <DataTemplate DataType="vm:RepoOpsViewModel">
                            <views:RepoOpsView />
                        </DataTemplate>
                    </ContentControl.DataTemplates>
                </ContentControl>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2"
                Background="#F0F0F0"
                BorderBrush="#E0E0E0"
                BorderThickness="0,1,0,0"
                Padding="16,6">
            <StackPanel Orientation="Horizontal" Spacing="24">
                <TextBlock FontSize="11"
                           Foreground="#666"
                           Text="{Binding StatusMessage}" />
                <TextBlock FontSize="11"
                           Foreground="#888"
                           Text="|" />
                <TextBlock FontSize="11"
                           Foreground="#888"
                           Text="{Binding RepositoryPath, StringFormat='仓库: {0}'}" />
            </StackPanel>
        </Border>
    </Grid>

    <!-- Navigation Button Styles -->
    <Window.Styles>
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#333" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.nav:pointerover">
            <Setter Property="Background" Value="#E8E8E8" />
        </Style>
        <Style Selector="Button.nav:pressed">
            <Setter Property="Background" Value="#D0D0D0" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#0078D4" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="#106EBE" />
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="#D32F2F" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button.danger:pointerover">
            <Setter Property="Background" Value="#C62828" />
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#E0E0E0" />
            <Setter Property="Foreground" Value="#333" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button.secondary:pointerover">
            <Setter Property="Background" Value="#D0D0D0" />
        </Style>
        <Style Selector="TextBox.input">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#D0D0D0" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="TextBox.input:focus">
            <Setter Property="BorderBrush" Value="#0078D4" />
        </Style>
    </Window.Styles>
</Window>
