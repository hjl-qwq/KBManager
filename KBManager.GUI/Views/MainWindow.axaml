<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:KBManager.GUI.ViewModels"
        xmlns:views="clr-namespace:KBManager.GUI.Views"
        x:Class="KBManager.GUI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="KBManager — Knowledge Base Workspace"
        Width="1280" Height="820"
        MinWidth="900" MinHeight="560"
        Background="{DynamicResource BackgroundDefaultColor}"
        WindowStartupLocation="CenterScreen">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveActiveDocumentCommand}" />
        <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseDocumentCommand}" />
        <KeyBinding Gesture="Ctrl+R" Command="{Binding ReloadActiveDocumentCommand}" />
    </Window.KeyBindings>

    <!-- Workspace only: no in-window title bar. The window's own title bar carries the
         product name, and everything the removed bar used to show (repository path,
         status message) lives in the status bar at the bottom. -->
    <Grid RowDefinitions="*,Auto">
        <!-- ═══ Workspace: activity bar · sidebar · splitter · editor ═══ -->
        <Grid Grid.Row="0">
            <!-- The sidebar column has a floor: the splitter may not shrink it past the
                 width its own header needs (the "共 N 个文件" summary plus the 新建 /
                 同步 / 折叠 buttons), otherwise the panel becomes unreadable.
                 200 ≈ margins 16 + summary ≈ 62 + three buttons ≈ 99 + spacing. -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="300" MinWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- Activity bar.
                 Top group switches the sidebar panel; the bottom group is pinned
                 like VS Code's settings/account corner and opens a tab in the
                 editor area instead. A separator makes the two behaviours obvious. -->
            <Border Grid.Column="0" Classes="activitybar">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Top: sidebar panels -->
                    <StackPanel Grid.Row="0">
                        <Grid ColumnDefinitions="3,*">
                            <Border Grid.Column="0"
                                    Background="{DynamicResource AccentBarColor}"
                                    IsVisible="{Binding IsExplorerActive}" />
                            <Button Grid.Column="1"
                                    Classes="activity"
                                    Classes.active="{Binding IsExplorerActive}"
                                    Command="{Binding ShowExplorerCommand}"
                                    Content="文件"
                                    ToolTip.Tip="资源管理器（在左侧栏显示已索引的文件）" />
                        </Grid>

                        <Grid ColumnDefinitions="3,*">
                            <Border Grid.Column="0"
                                    Background="{DynamicResource AccentBarColor}"
                                    IsVisible="{Binding IsSearchActive}" />
                            <Button Grid.Column="1"
                                    Classes="activity"
                                    Classes.active="{Binding IsSearchActive}"
                                    Command="{Binding ShowSearchCommand}"
                                    Content="检索"
                                    ToolTip.Tip="按标签检索（在左侧栏显示）" />
                        </Grid>
                    </StackPanel>

                    <!-- Bottom: tools that open a tab -->
                    <StackPanel Grid.Row="2">
                        <Border Height="1"
                                Margin="8,6"
                                Background="{DynamicResource BorderDefaultColor}" />

                        <Grid ColumnDefinitions="3,*">
                            <Border Grid.Column="0"
                                    Background="{DynamicResource AccentBarColor}"
                                    IsVisible="{Binding IsSettingsActive}" />
                            <Button Grid.Column="1"
                                    Classes="activity"
                                    Classes.active="{Binding IsSettingsActive}"
                                    Command="{Binding OpenSettingsCommand}"
                                    Content="设置"
                                    ToolTip.Tip="设置（在编辑区以标签页打开）" />
                        </Grid>

                        <Grid ColumnDefinitions="3,*">
                            <Border Grid.Column="0"
                                    Background="{DynamicResource AccentBarColor}"
                                    IsVisible="{Binding IsLogActive}" />
                            <Button Grid.Column="1"
                                    Classes="activity"
                                    Classes.active="{Binding IsLogActive}"
                                    Command="{Binding OpenLogCommand}"
                                    Content="日志"
                                    ToolTip.Tip="运行日志（在编辑区以标签页打开）" />
                        </Grid>

                        <Grid ColumnDefinitions="3,*">
                            <Border Grid.Column="0"
                                    Background="{DynamicResource AccentBarColor}"
                                    IsVisible="{Binding IsGitActive}" />
                            <Button Grid.Column="1"
                                    Classes="activity"
                                    Classes.active="{Binding IsGitActive}"
                                    Command="{Binding OpenGitCommand}"
                                    Content="Git"
                                    ToolTip.Tip="Git 操作（在编辑区以标签页打开）" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Sidebar: explorer or search -->
            <Border Grid.Column="1" Classes="sidebar">
                <ContentControl Content="{Binding SidebarContent}">
                    <ContentControl.DataTemplates>
                        <DataTemplate DataType="vm:ExplorerViewModel">
                            <views:ExplorerView />
                        </DataTemplate>
                        <DataTemplate DataType="vm:SearchViewModel">
                            <views:SearchView />
                        </DataTemplate>
                    </ContentControl.DataTemplates>
                </ContentControl>
            </Border>

            <!-- Resizable divider -->
            <GridSplitter Grid.Column="2"
                          Width="4"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext" />

            <!-- Editor area -->
            <Border Grid.Column="3" Classes="editorhost">
                <views:EditorHostView />
            </Border>
        </Grid>

        <!-- ═══ Status bar ═══
             Carries the status message that the removed title bar used to show, so a
             failed sync or a refused file operation is still visible. Fixed height, the
             same as the document status strip inside the editor. -->
        <Border Grid.Row="1" Classes="statusbar" Height="26" Padding="12,0">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                <TextBlock Grid.Column="0"
                           FontSize="11"
                           VerticalAlignment="Center"
                           MaxWidth="360"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextStatusColor}"
                           Text="{Binding RepositoryPath, StringFormat='仓库: {0}'}" />

                <TextBlock Grid.Column="1"
                           FontSize="11"
                           Margin="16,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedColor}"
                           Text="{Binding FileCount, StringFormat='文件 {0}'}" />

                <TextBlock Grid.Column="2"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedColor}"
                           Text="{Binding TagCount, StringFormat='标签 {0}'}" />

                <TextBlock Grid.Column="3"
                           FontSize="11"
                           Margin="16,0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextStatusColor}"
                           Text="{Binding StatusMessage}" />

                <TextBlock Grid.Column="4"
                           FontSize="11"
                           VerticalAlignment="Center"
                           MaxWidth="320"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextMutedColor}"
                           Text="{Binding ActiveDocumentLocation}" />
            </Grid>
        </Border>
    </Grid>
</Window>
