<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:KBManager.GUI.ViewModels"
             xmlns:views="clr-namespace:KBManager.GUI.Views"
             x:Class="KBManager.GUI.Views.ToolDocumentView"
             x:DataType="vm:ToolDocumentViewModel">
    <ContentControl Content="{Binding Page}">
        <ContentControl.DataTemplates>
            <DataTemplate DataType="vm:SettingsViewModel">
                <views:SettingsView />
            </DataTemplate>
            <DataTemplate DataType="vm:RepoOpsViewModel">
                <views:RepoOpsView />
            </DataTemplate>
            <DataTemplate DataType="vm:LogViewModel">
                <views:LogView />
            </DataTemplate>
            <DataTemplate DataType="vm:StaleRecordsViewModel">
                <views:StaleRecordsView />
            </DataTemplate>
            <!-- Stage 1 验证页，验证后连同 PreviewProbeViewModel 一起删除 -->
            <DataTemplate DataType="vm:PreviewProbeViewModel">
                <views:PreviewProbeView />
            </DataTemplate>
        </ContentControl.DataTemplates>
    </ContentControl>
</UserControl>
