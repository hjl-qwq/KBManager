<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:KBManager.GUI.Views"
        x:Class="KBManager.GUI.Views.ConfirmationDialog"
        x:DataType="views:ConfirmationDialog"
        Width="420" Height="200"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{DynamicResource BackgroundDefaultColor}"
        Foreground="{DynamicResource TextPrimaryColor}"
        Title="Confirm">
    <Window.Styles>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource PrimaryColor}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundColor}" />
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="{DynamicResource SecondaryColor}" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundColor}" />
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryColor}" />
        </Style>
    </Window.Styles>
    <Grid RowDefinitions="*,Auto" Margin="24,20">
        <TextBlock Grid.Row="0"
                   Text="{Binding Message}"
                   TextWrapping="Wrap"
                   FontSize="14"
                   Foreground="{DynamicResource TextPrimaryColor}"
                   VerticalAlignment="Center" />
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="12"
                    Margin="0,16,0,0">
            <Button Classes="secondary"
                    Content="取消"
                    Width="80"
                    Click="OnNoClicked" />
            <Button Classes="primary"
                    Content="确定"
                    Width="80"
                    Click="OnYesClicked" />
        </StackPanel>
    </Grid>
</Window>
